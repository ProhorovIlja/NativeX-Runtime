#version 450
// Original deterministic native Vulkan compute workload; no game shaders.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer Output {
    uint pixels[];
} output_data;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 256) {
        output_data.pixels[i] = (i * 37u + 11u) ^ 0x5a5aa5a5u;
    }
}
